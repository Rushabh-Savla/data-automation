# ────────────────────────────────────────────────────────────────
# Platform configuration — copy this file to .env and fill in your values.
# Values here are also settable directly as env vars (env vars win).
# ────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/data_automation

# ── Redis (Celery broker/result backend + pub/sub + control flags) ─
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────────
# NAS_ROOT: where promoted images/annotations are written. Point this at a
# mounted NAS path in production (e.g. a mapped drive or UNC path); a local
# folder is fine for development.
NAS_ROOT=./nas_data
# WORK_ROOT: scratch space for in-flight downloads before promotion.
WORK_ROOT=./work_data

# ── API auth ─────────────────────────────────────────────────────
# Comma-separated list of accepted API keys (checked via the X-API-Key header,
# or an `api_key` query param for the WebSocket endpoint).
API_KEYS=dev-local-key

# ── Credential encryption ───────────────────────────────────────────
# Fernet key used to encrypt API keys stored via the Credentials API.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── Source credentials (fallback if not set via the Credentials API) ──
# YouTube Data API v3 — needed only for query-based video search.
# Get at: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=

# Kaggle — get at: https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# Roboflow — get at: https://app.roboflow.com/ → Settings → Roboflow API
ROBOFLOW_API_KEY=

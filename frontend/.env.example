# Leave unset (or empty) to use the Vite dev-server proxy (/api, /ws) —
# see vite.config.ts. Only set these to absolute URLs when the frontend and
# backend are NOT co-located behind the same dev proxy / nginx container.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Dev-only convenience seed for the API key (stored in localStorage after
# first load, editable via the app — this is not baked into the prod build).
VITE_API_KEY=dev-local-key

FROM python:3.13-slim

WORKDIR /srv

# git is needed at `uv sync` time below: the shared pyproject.toml pins the
# YOLO-World CLIP dependency as a git URL (see app/filtering/
# yolo_world_filter.py) even though this API image never imports it.
# libgl1, libglib2.0-0, libxcb1, libx11-xcb1 are runtime dependencies for opencv/cv2
RUN apt-get update && apt-get install -y --no-install-recommends \
    git libgl1 libglib2.0-0 libxcb1 libx11-xcb1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# ultralytics pulls in the full torch/CUDA wheel stack (nvidia-cublas alone
# is 400MB+) — uv's default 30s per-request timeout is too short for these
# on a slow/congested connection and the build fails with a network-timeout
# error that looks unrelated (e.g. failing on an unrelated small package
# like lxml, whichever request lands during the slow window).
ENV UV_HTTP_TIMEOUT=300

COPY pyproject.toml uv.lock* ./
COPY sam3 ./sam3
RUN uv sync --no-dev || uv pip install --system -e .

COPY app ./app
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic

EXPOSE 8000

CMD ["uv", "run", "--no-sync", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Worker image bakes in ffmpeg (YouTube frame extraction) and deno (yt-dlp's
# JS-runtime dependency for solving YouTube's n-challenge) so the runtime
# environment is deterministic instead of depending on the host's PATH, which
# is what the legacy youtube_downloader.py script did (see app/connectors/
# youtube_connector.py for the removed PATH-shimming logic).
FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg curl unzip ca-certificates git libgl1 libglib2.0-0 libxcb1 libx11-xcb1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh
ENV PATH="/usr/local/bin:${PATH}"

WORKDIR /srv

RUN pip install --no-cache-dir uv

# ultralytics pulls in the full torch/CUDA wheel stack (nvidia-cublas alone
# is 400MB+) — uv's default 30s per-request timeout is too short for these
# on a slow/congested connection and the build fails with a network-timeout
# error that looks unrelated (e.g. failing on an unrelated small package
# like lxml, whichever request lands during the slow window).
ENV UV_HTTP_TIMEOUT=300

COPY pyproject.toml uv.lock* ./
COPY sam3 ./sam3
RUN uv sync --no-dev || uv pip install --system -e .

COPY app ./app

# -Q is required: task_routes (app/tasks/celery_app.py) sends every real task
# to a named queue (discovery/download/standardize/cleanup/orchestration/
# filtering/export), not the "celery" default — a worker started without an
# explicit -Q only consumes "celery" and silently never picks up any actual
# work, which is exactly the bug this comment is here to prevent regressing.
# docker-compose.yml overrides this `command:` for both the IO worker and the
# GPU filtering worker, which consume different queue sets at different
# concurrencies. This default is the all-in-one fallback for running the image
# directly (no compose) and keeps every queue covered so that case still works.
CMD ["uv", "run", "--no-sync", "celery", "-A", "app.tasks.celery_app", "worker", "--loglevel=info", "--concurrency=4", \
     "-Q", "celery,discovery,download,standardize,cleanup,orchestration,filtering,export"]

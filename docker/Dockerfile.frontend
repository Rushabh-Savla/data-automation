# Multi-stage: build the SPA with Node, serve the static output with nginx —
# nginx also reverse-proxies /api and /ws to the api service so every
# request the browser makes is same-origin, sidestepping the need for CORS
# in this deployment path entirely (see app/main.py's CORS middleware,
# which is only actually required if frontend/backend end up on two
# different public origins with no proxy in front of both).
FROM node:22-slim AS build
WORKDIR /srv
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Relative paths — resolved same-origin through nginx's proxy below, not
# baked-in absolute hosts, so this image works unmodified in any compose
# project name / host port mapping.
ENV VITE_API_BASE_URL=/api/v1
ENV VITE_WS_BASE_URL=/ws/v1
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/dist /usr/share/nginx/html
EXPOSE 80
